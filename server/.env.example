# TTS provider: auto | edge | gtts | openai
# Use edge-tts>=7.2.7 (pip install -U 'edge-tts>=7.2.7') — fixes 403 errors
TTS_PROVIDER=auto

# Optional — only needed for OpenAI TTS / AI text enhancement
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_TTS_MODEL=tts-1-hd
# OPENAI_ENHANCE_MODEL=gpt-4o-mini

# Video enhancement (requires FFmpeg)
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
# VIDEO_ENHANCE_MODE=fast   # fast (default, single FFmpeg pass) | ai (Real-ESRGAN, slow)
# VIDEO_HW_ENCODER=videotoolbox   # optional macOS hardware encode (faster)
# VIDEO_MAX_MB=500
# VIDEO_MAX_DURATION_SEC=600
# VIDEO_X264_PRESET=medium
# VIDEO_CRF=19
# VIDEO_FRAME_WORKERS=8   # only for ai mode

# AI Voice Studio
# STUDIO_MAX_MB=50
# STUDIO_MAX_DURATION_SEC=300
# STUDIO_NEURAL_VOICE=true   # Microsoft Edge TTS (AnaNeural, JennyNeural — royalty-free)

# AI Video Generator — free local animation (no credits, no watermark)
# VIDEO_GEN_AI=free          # free (default) | parallax | svd | motion
# VIDEO_GEN_MAX_MB=30
# VIDEO_GEN_MAX_IMAGES=12
# VIDEO_GEN_PARALLEL=2
# VIDEO_GEN_DISABLE_SVD=true # set false + install torch/diffusers for neural SVD (slow on CPU)
# VIDEO_HW_ENCODER=h264_videotoolbox
# VIDEO_X264_PRESET=medium
# VIDEO_GEN_ALLOW_MOTION_FALLBACK=false
#
# Optional paid cloud (off by default):
# VIDEO_GEN_ALLOW_CLOUD=false
# HF_TOKEN=
# FAL_KEY=
